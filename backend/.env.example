HTTP_ADDR=:8002
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgres://mixm:mixm@localhost:5432/mixm?sslmode=disable
REDIS_URL=redis://localhost:6379/2
RABBITMQ_URL=amqp://mixm:mixm@localhost:5672/
RABBITMQ_QUEUE=instance_create
WORKER_CONCURRENCY=4

# deploy/middleware/docker-compose.yaml 的部署参数，统一通过 --env-file 传入。
POSTGRES_DB=mixm
POSTGRES_USER=mixm
POSTGRES_PASSWORD=mixm
RABBITMQ_USER=mixm
RABBITMQ_PASSWORD=mixm
RABBITMQ_HOSTNAME=rabbitmq

# 默认卷名统一使用 mixm 前缀；已有部署可填写实际旧卷名复用数据。
# POSTGRES_VOLUME_NAME=mixm_postgres_data
# RABBITMQ_VOLUME_NAME=mixm_rabbitmq_data
# REDIS_VOLUME_NAME=mixm_redis_data
# BACKEND_UPLOADS_VOLUME_NAME=mixm_backend_uploads
# BACKEND_STATIC_VOLUME_NAME=mixm_backend_static
# BACKEND_DATA_VOLUME_NAME=mixm_backend_data

# 应用容器默认通过 mixm-services 网络连接中间件。
# 连接其他主机或已有服务时，设置以下地址；localhost 仅用于上面的本地 Go 开发配置。
# DEPLOY_DATABASE_URL=postgres://mixm:mixm@postgres:5432/mixm?sslmode=disable
# DEPLOY_REDIS_URL=redis://redis:6379/2
# DEPLOY_RABBITMQ_URL=amqp://mixm:mixm@rabbitmq:5672/
# DEPLOY_RUSTFS_ENDPOINT=http://rustfs:9000
# DEPLOY_REGISTRY_URL=http://registry:5000

K8S_CONFIG_PATH=kubeconfig/k3s.yaml
K8S_SSH_GATEWAY_HOST=localhost
K8S_CODE_SERVER_HOST=localhost
K8S_SSH_PORT=30022
SSH_HOST_KEY_PATH=data/ssh_host_key
STORAGE_CLASS_NAME=longhorn
PVC_ACCESS_MODE=ReadWriteMany
USER_PERSONAL_PVC_CAPACITY=10Gi

# Registry 保留原有监听地址；更换部署主机时同步调整下面的地址。
REGISTRY_BIND_ADDRESS=172.18.120.33
REGISTRY_PORT=55000
# 本地 Go 使用宿主机地址；应用容器默认使用 registry:5000。
REGISTRY_URL=http://172.18.120.33:55000
# 镜像名称前缀必须能被构建主机和 Kubernetes 节点访问。
REGISTRY_PREFIX=172.18.120.33:55000
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
RUSTFS_ENDPOINT=http://localhost:19000
RUSTFS_BUCKET=content
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
UPLOAD_DIR=uploads/assignments
EXPORT_DIR=static/export

LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
