HTTP_ADDR=:8002
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgres://mutim:mutim@localhost:5432/mutim?sslmode=disable
REDIS_URL=redis://localhost:6379/2
RABBITMQ_URL=amqp://mutim:mutim@localhost:5672/
RABBITMQ_QUEUE=instance_create
WORKER_CONCURRENCY=4

# 独立中间件 Compose 的部署参数，启动时统一通过 --env-file 传入。
POSTGRES_PASSWORD=mutim
RABBITMQ_PASSWORD=mutim
RABBITMQ_HOSTNAME=rabbitmq

# 应用容器默认通过 mixm-services 网络连接中间件。
# 连接其他主机或已有服务时，设置以下地址；localhost 仅用于上面的本地 Go 开发配置。
# DEPLOY_DATABASE_URL=postgres://mutim:mutim@postgres:5432/mutim?sslmode=disable
# DEPLOY_REDIS_URL=redis://redis:6379/2
# DEPLOY_RABBITMQ_URL=amqp://mutim:mutim@rabbitmq:5672/
# DEPLOY_RUSTFS_ENDPOINT=http://rustfs:9000

K8S_CONFIG_PATH=kubeconfig/k3s.yaml
K8S_SSH_GATEWAY_HOST=localhost
K8S_CODE_SERVER_HOST=localhost
K8S_SSH_PORT=30022
SSH_HOST_KEY_PATH=data/ssh_host_key
STORAGE_CLASS_NAME=longhorn
PVC_ACCESS_MODE=ReadWriteMany
USER_PERSONAL_PVC_CAPACITY=10Gi

REGISTRY_URL=http://localhost:5000
REGISTRY_PREFIX=localhost:5000
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
RUSTFS_ENDPOINT=http://localhost:19000
RUSTFS_BUCKET=content
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
UPLOAD_DIR=uploads/assignments
EXPORT_DIR=static/export

LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
