SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./app.db
K8S_CONFIG_PATH=kubeconfig/k3s.yaml
K8S_SSH_GATEWAY_HOST=localhost           # SSH是FastAPI Gateway启动的，所以是服务的主机地址
K8S_CODE_SERVER_HOST=localhost   

K8S_SSH_PORT=30022
REGISTRY_URL=http://localhost:5000
REGISTRY_PREFIX=localhost:5000
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_DELETE_TIMEOUT_SECONDS=30

STORAGE_CLASS_NAME=longhorn # 存储类名称，默认为 local-path，适用于大多数环境；如果使用 Longhorn，可以改为 longhorn
PVC_ACCESS_MODE=ReadWriteMany # PVC访问模式，默认为ReadWriteOnce，适用于大多数场景；如果需要多个实例共享同一个PVC，可以改为ReadWriteMany
USER_PERSONAL_PVC_CAPACITY=10Gi # 每个用户个人PVC的固定容量，单位Gi，避免每个实例都创建一个独占PVC导致资源浪费

RUSTFS_ENDPOINT="http://localhost:19000"
RUSTFS_BUCKET="content"
RUSTFS_ACCESS_KEY="rustfsadmin"
RUSTFS_SECRET_KEY="rustfsadmin"


# 出题LLM相关配置
LLM_API_URL: str = "https://api.deepseek.com"
LLM_API_KEY: str = ""
LLM_MODEL: str = "deepseek-v4-flash"

# Knowledge Tracing backend:
# heuristic: current online mastery updater
# akt: enable AKT runtime check (requires pykt-toolkit, torch, checkpoint)
KT_MODEL_BACKEND=heuristic
KT_AKT_CHECKPOINT=
KT_AKT_DEVICE=cpu
KT_SERVICE_URL=http://kt-service:8010
KT_SERVICE_TIMEOUT_SECONDS=3
