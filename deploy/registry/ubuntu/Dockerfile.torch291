# syntax=docker/dockerfile:1
FROM ubuntu:24.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 使用基础镜像中已有的用户。
ARG USERNAME=ubuntu

ENV DEBIAN_FRONTEND=noninteractive

# APT 索引和下载缓存保存在 BuildKit 挂载中。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        less \
        libssl-dev \
        openssh-server \
        pkg-config \
        python3 \
        python3-pip \
        sudo \
        vim

RUN curl -fsSL https://astral.sh/uv/install.sh -o /tmp/install-uv.sh \
    && env UV_INSTALL_DIR=/usr/local/bin sh /tmp/install-uv.sh \
    && rm -f /tmp/install-uv.sh

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

RUN uv venv "${VIRTUAL_ENV}"

# 延迟展开 PATH，保留 SSH 登录和交互式 Bash 的运行时环境。
RUN cat > /etc/profile.d/auto-venv.sh <<'EOF'
if [ -d /opt/venv ]; then
    export VIRTUAL_ENV=/opt/venv
    case ":${PATH}:" in
        *:/opt/venv/bin:*) ;;
        *) export PATH="/opt/venv/bin:${PATH}" ;;
    esac
fi
EOF

RUN cat /etc/profile.d/auto-venv.sh >> /etc/bash.bashrc \
    && sed -i 's/\r$//' /etc/profile.d/auto-venv.sh /etc/bash.bashrc

ARG TORCH_VERSION=2.9.1
ARG TORCH_DEVICE=cpu
ARG TORCH_CUDA_TAG=cu128

# TORCH_DEVICE 支持 cpu 和 cuda；CUDA 通道由 TORCH_CUDA_TAG 指定。
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    set -eux; \
    if [ "${TORCH_DEVICE}" = "cpu" ]; then \
        uv pip install \
            --python "${VIRTUAL_ENV}/bin/python" \
            --index-url https://download.pytorch.org/whl/cpu \
            "torch==${TORCH_VERSION}"; \
    elif [ "${TORCH_DEVICE}" = "cuda" ]; then \
        uv pip install \
            --python "${VIRTUAL_ENV}/bin/python" \
            --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_TAG}" \
            "torch==${TORCH_VERSION}"; \
    else \
        echo "Invalid TORCH_DEVICE=${TORCH_DEVICE}, expected: cpu or cuda" >&2; \
        exit 1; \
    fi

# 配置用户权限、默认 SSH 密码和 SSH 服务。
RUN set -eux; \
    if ! id -u "${USERNAME}" > /dev/null 2>&1; then \
        echo "Error: User ${USERNAME} not found" >&2; \
        exit 1; \
    fi; \
    usermod -aG sudo "${USERNAME}"; \
    printf '%s ALL=(ALL) NOPASSWD:ALL\n' "${USERNAME}" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    printf '%s:ubuntu\n' "${USERNAME}" | chpasswd; \
    mkdir -p /var/run/sshd; \
    ssh-keygen -A; \
    sed -i \
        -e 's/^#\?PermitRootLogin.*/PermitRootLogin no/' \
        -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' \
        -e 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication no/' \
        -e 's/^#\?KbdInteractiveAuthentication.*/KbdInteractiveAuthentication yes/' \
        -e 's/^#\?X11Forwarding.*/X11Forwarding yes/' \
        -e 's/^#\?UsePAM.*/UsePAM yes/' \
        /etc/ssh/sshd_config; \
    printf 'AllowUsers %s\n' "${USERNAME}" >> /etc/ssh/sshd_config

WORKDIR /workspace

RUN chown "${USERNAME}:${USERNAME}" /workspace

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D", "-e"]
